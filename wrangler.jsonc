{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simplicity",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simplicity-d1",
      "database_id": "simplicity-d1-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "simplicity-receipts"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "SIMPLICITY_KV"
    }
  ]
}
