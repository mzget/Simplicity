{
  "name": "simplicity-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "spendee:export": "node scripts/extract-spendee.mjs",
    "spendee:import:local": "node scripts/import-spendee-local.mjs",
    "spendee:import:remote": "node scripts/import-spendee-local.mjs --remote",
    "cf:dev": "wrangler pages dev dist --port 8788 --ip 127.0.0.1",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply simplicity-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply simplicity-d1 --remote",
    "db:clean:local": "node scripts/clean-local-db.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:frontend": "vite",
    "dev:backend": "wrangler pages dev dist --port 8788 --ip 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "papaparse": "^5.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^3.111.0"
  }
}
